{
  "author": "Pavel Vlasenko <psvlasenko@gmail.com>",
  "name": "depknit",
  "version": "0.1.0",
  "description": "A simple, lightweight, and type-safe dependency injection library",
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "container",
    "typescript",
    "type-safe"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/type-tests/**",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || >=24"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psvlasenko/depknit.git"
  },
  "homepage": "https://github.com/psvlasenko/depknit#readme",
  "bugs": {
    "url": "https://github.com/psvlasenko/depknit/issues"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "node --test --test-reporter=spec dist/*.test.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "lint": "eslint .",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
